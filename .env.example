# SmartAlarmPi environment variables
SECRET_KEY=replace_with_a_random_secret
# Leave blank to use local espeak-ng. Both are needed for ElevenLabs;
# the voice ID is the long ID from your ElevenLabs voice library, not a voice name.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DATABASE_URL=sqlite+aiosqlite:///./data/smartalarm.db
PIPEWIRE_SINK=@DEFAULT_AUDIO_SINK@
TIMEZONE=Europe/London
