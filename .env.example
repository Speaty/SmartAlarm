# SmartAlarmPi environment variables
# Leave blank to use local espeak-ng. Both are needed for ElevenLabs;
# the voice ID is the long ID from your ElevenLabs voice library, not a voice name.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DATABASE_URL=sqlite+aiosqlite:///./data/smartalarm.db
PIPEWIRE_SINK=@DEFAULT_AUDIO_SINK@
# Startup levels (0-100). Volume is the speaker; music and voice balance radio against speech.
DEFAULT_ALARM_VOLUME=70
DEFAULT_MUSIC_LEVEL=100
DEFAULT_VOICE_LEVEL=100
TIMEZONE=Europe/London
# Secret iCal address(es) for the schedule summary, comma-separated.
# Google Calendar: Settings > your calendar > Integrate calendar > Secret address in iCal format
CALENDAR_ICAL_URLS=
